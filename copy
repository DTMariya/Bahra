# 1. One dry run first - 10 minutes, watch a real truck, post nothing
.\Start-WeighbridgeAgent.ps1 -DryRun -RunForSeconds 600

# 2. Then start it properly, detached so closing the window doesn't kill it
Start-Process powershell -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass',
  '-File','C:\weighbridge\Start-WeighbridgeAgent.ps1' -WindowStyle Hidden

# 3. Check on it any time
.\Test-WeighbridgeAgent.ps1

Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass
Get-ChildItem .\*.ps1 | Unblock-File


$dir = 'C:\...\Bahara Weight Bridge'   # the folder with Start-WeighbridgeAgent.ps1 on the server

$action   = New-ScheduledTaskAction -Execute 'powershell.exe' `
              -Argument "-NoProfile -ExecutionPolicy Bypass -File `"$dir\Start-WeighbridgeAgent.ps1`" -RunForSeconds 86400" `
              -WorkingDirectory $dir
$settings = New-ScheduledTaskSettingsSet -ExecutionTimeLimit (New-TimeSpan -Hours 25)

Register-ScheduledTask -TaskName 'WeighbridgeAgent-24h' -Action $action -Settings $settings -User 'SYSTEM' -RunLevel Highest
Start-ScheduledTask  -TaskName 'WeighbridgeAgent-24h'

