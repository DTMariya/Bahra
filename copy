# 1. One dry run first - 10 minutes, watch a real truck, post nothing
.\Start-WeighbridgeAgent.ps1 -DryRun -RunForSeconds 600

# 2. Then start it properly, detached so closing the window doesn't kill it
Start-Process powershell -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass',
  '-File','C:\weighbridge\Start-WeighbridgeAgent.ps1' -WindowStyle Hidden

# 3. Check on it any time
.\Test-WeighbridgeAgent.ps1

Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass
Get-ChildItem .\*.ps1 | Unblock-File


$dir  = 'C:\weighbridge'
$task = 'WeighbridgeAgent-24h'

# 1. Remove the earlier task that points at the wrong folder
Unregister-ScheduledTask -TaskName $task -Confirm:$false -ErrorAction SilentlyContinue

# 2. Make sure the script and config are actually there
if (-not (Test-Path "$dir\Start-WeighbridgeAgent.ps1"))       { throw "Start-WeighbridgeAgent.ps1 not found in $dir" }
if (-not (Test-Path "$dir\weighbridge-agent.config.json"))    { throw "weighbridge-agent.config.json not found in $dir" }

# 3. Create the task: run the agent for 24 hours (86400 s) as SYSTEM
$action   = New-ScheduledTaskAction -Execute 'powershell.exe' `
              -Argument "-NoProfile -ExecutionPolicy Bypass -File `"$dir\Start-WeighbridgeAgent.ps1`" -RunForSeconds 86400" `
              -WorkingDirectory $dir
$settings = New-ScheduledTaskSettingsSet -ExecutionTimeLimit (New-TimeSpan -Hours 25)
Register-ScheduledTask -TaskName $task -Action $action -Settings $settings -User 'SYSTEM' -RunLevel Highest | Out-Null

# 4. Start it and give it time to connect to the terminals
Start-ScheduledTask -TaskName $task
Start-Sleep -Seconds 20

# 5. Check it
Get-ScheduledTask     -TaskName $task | Select-Object TaskName, State
Get-ScheduledTaskInfo -TaskName $task | Select-Object LastRunTime, LastTaskResult
& "$dir\Test-WeighbridgeAgent.ps1"
Get-Content "$dir\logs\agent-$(Get-Date -Format yyyy-MM-dd).log" -Tail 15

